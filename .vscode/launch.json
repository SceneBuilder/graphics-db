{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "debugpy (notJustMyCode)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "debugpy (notJustMyCode, args)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "${input:args}"
            ],
            "justMyCode": false
        },
        {
            "name": "Setup Extra Index (Test; limit 1000)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "${input:args}",
                "--limit",
                "1000"
            ],
            "justMyCode": false
        }
    ],
    "inputs": [
        {
            "id": "args",
            "type": "promptString",
            "description": "An argument."
        }
    ]
}